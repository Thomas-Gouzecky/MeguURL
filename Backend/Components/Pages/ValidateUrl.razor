@page "/Validate"
@inject ValidationService ValidationService

<input type="text" @bind="UrlInput" @bind:event="oninput"/>
<p class="@TextColor fs-4 fw-bold">@UrlValidation.ValidUrl</p>
<a class="fs-4 fw-bold" href="@UrlValidation.NormalizedUrl">@UrlValidation.NormalizedUrl</a>

@code {
    string UrlInput = "";
    (bool ValidUrl, string NormalizedUrl) UrlValidation =>
        ValidationService.IsNormalizedUrlValid(UrlInput);
    string TextColor => UrlValidation.ValidUrl ? "text-success" : "text-danger";

}
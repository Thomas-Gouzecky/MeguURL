@page "/"

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

<EditForm FormName="shortenUrlForm" Model="@model" OnSubmit="ShortenUrl">
    <InputText @bind-Value="model.LongUrl"/>
    <button type="submit">Shorten Url</button>
</EditForm>

<p>@ShortUrlCode</p>

<p>@ErrorMessage</p>

@code {
    private CreateUrlRequest model = new();
    private readonly HttpClient http = new HttpClient();
    private int? ShortUrlCode;
    private string? ErrorMessage;

    private async Task ShortenUrl() 
    {
        var response = await http.PostAsJsonAsync("http://localhost:6767/api/urls/", model);

        if (!response.IsSuccessStatusCode)
        {
            ErrorMessage = await response.Content.ReadAsStringAsync();
            return;
        }

        ErrorMessage = null;

        var result = await response.Content.ReadFromJsonAsync<GetUrlRequest>();
        ShortUrlCode = result?.Id;
    }
}
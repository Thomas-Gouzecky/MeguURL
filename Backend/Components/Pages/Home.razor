@page "/"
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

<EditForm FormName="shortenUrlForm" Model="@model" OnSubmit="ShortenUrl">
    <InputText @bind-Value="model.LongUrl"/>
    <button type="submit">Shorten Url</button>
</EditForm>

@if (ShortUrl != null && ShortUrlCode != null)
{
    <p>Your Specific URL Code is: @ShortUrlCode</p>
    <p>
        Your URL can be accessed at:
        <a class="link-primary" href="@ShortUrl">@ShortUrl</a>
    </p>
    
}

<h5>@ErrorTitle</h5>
<p>@ErrorMessage</p>
<p>@ErrorUrl</p>

@code {

    private CreateUrlRequest model = new();
    private HttpClient? http;
    private string? ShortUrlCode;
    private string? ShortUrl;
    private string? ErrorTitle;
    private string? ErrorMessage;
    private string? ErrorUrl;

    protected override void OnInitialized()
    {
        http = HttpClientFactory.CreateClient("BackendApi");
    }

    private async Task ShortenUrl() 
    {
        var response = await http!.PostAsJsonAsync("/api/urls/", model);

        if (!response.IsSuccessStatusCode)
        {
            var res = await response.Content.ReadFromJsonAsync<ProblemDetailsResponse>();
            ErrorTitle = res?.Title ?? "Error";
            ErrorMessage = res?.Detail ?? "Error";
            ErrorUrl = res?.Url ?? "";
            return;
        }

        var result = await response.Content.ReadFromJsonAsync<CreateUrlResponse>();

        if (result == null)
        {
            ErrorMessage = await response.Content.ReadAsStringAsync();
            return;
        }

        ErrorMessage = null;
        ShortUrlCode = result.Code;
        ShortUrl = result.ShortUrl;
    }
}
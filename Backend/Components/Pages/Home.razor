@page "/"
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

<EditForm FormName="shortenUrlForm" Model="@model" OnSubmit="ShortenUrl">
    <InputText @bind-Value="model.LongUrl"/>
    <button type="submit">Shorten Url</button>
</EditForm>

<p>@ShortUrlCode</p>
<p>@ShortUrl</p>

<p>@ErrorMessage</p>

@code {

    private CreateUrlRequest model = new();
    private HttpClient? http;
    private string? ShortUrlCode;
    private string? ShortUrl;
    private string? ErrorMessage;

    protected override void OnInitialized()
    {
        http = HttpClientFactory.CreateClient("BackendApi");
    }

    private async Task ShortenUrl() 
    {
        var response = await http!.PostAsJsonAsync("api/urls/", model);

        if (!response.IsSuccessStatusCode)
        {
            ErrorMessage = await response.Content.ReadAsStringAsync();
            return;
        }

        var result = await response.Content.ReadFromJsonAsync<CreateUrlResponse>();

        if (result == null)
        {
            ErrorMessage = await response.Content.ReadAsStringAsync();
            return;
        }

        ErrorMessage = null;
        ShortUrlCode = result.Code;
        ShortUrl = result.ShortUrl;
    }
}